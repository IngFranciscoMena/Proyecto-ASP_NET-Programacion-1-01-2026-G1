@model IEnumerable<RegistroUsuariosApp.Models.Usuario>

@{
    ViewData["Title"] = "Index";
}

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Listado de Clientes</h2>
    </div>
    <div class="card-body">
        <p>
            <a class="btn btn-success" asp-action="Create">Nuevo Cliente</a>
        </p>
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Nombres)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Apellidos)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.NombreUsuario)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IdEstadoNavigation)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.IdRolNavigation)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Nombres)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Apellidos)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.NombreUsuario)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IdEstadoNavigation.NombreEstado)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IdRolNavigation.NombreRol)
                        </td>
                        <td>
                            <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.IdUsuario">Edit</a> |
                            <a class="btn btn-info" asp-action="Details" asp-route-id="@item.IdUsuario">Details</a> |
                            <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.IdUsuario">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>



